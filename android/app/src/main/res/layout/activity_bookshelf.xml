<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigationBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_small">

            <!-- Header Info -->
            <RelativeLayout
                android:id="@+id/headerInfo"
                android:layout_width="112dp"
                android:layout_height="26dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:alpha="0.8">

                <TextView
                    android:id="@+id/headerTitle"
                    android:layout_width="94dp"
                    android:layout_height="13dp"
                    android:text="Title"
                    android:textSize="11sp"
                    android:textStyle="normal"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.5" />

                <TextView
                    android:id="@+id/headerSubtitle"
                    android:layout_width="112dp"
                    android:layout_height="13dp"
                    android:layout_below="@id/headerTitle"
                    android:text="Subtitle"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.4" />
            </RelativeLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/title"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="PuRe"
                android:textSize="72sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.03"
                android:layout_marginStart="20dp"
                android:layout_marginTop="65dp"
                android:lineSpacingExtra="0sp"
                android:lineSpacingMultiplier="1.2" />

            <!-- Bookmarks and Recent Section -->
            <RelativeLayout
                android:layout_width="394dp"
                android:layout_height="240dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_background"
                android:elevation="@dimen/card_elevation">

                <!-- Bookmarks Section -->
                <RelativeLayout
                    android:id="@+id/bookmarksSection"
                    android:layout_width="378dp"
                    android:layout_height="93dp"
                    android:layout_marginStart="9dp"
                    android:layout_marginTop="19dp"
                    android:background="@drawable/white_card_background"
                    android:elevation="@dimen/card_elevation">

                    <ImageView
                        android:id="@+id/bookmarkIcon"
                        android:layout_width="67dp"
                        android:layout_height="67dp"
                        android:layout_marginStart="12dp"
                        android:layout_centerVertical="true"
                        android:src="@android:drawable/star_big_on"
                        android:tint="@color/dark_gray"
                        android:contentDescription="Bookmark" />

                    <TextView
                        android:id="@+id/bookmarksTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bookmarks"
                        android:textSize="22sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_toEndOf="@id/bookmarkIcon"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="19dp" />
                </RelativeLayout>

                <!-- Recent Opened News Section -->
                <RelativeLayout
                    android:id="@+id/recentSection"
                    android:layout_width="378dp"
                    android:layout_height="93dp"
                    android:layout_marginStart="9dp"
                    android:layout_marginTop="110dp"
                    android:background="@drawable/white_card_background"
                    android:elevation="@dimen/card_elevation">

                    <ImageView
                        android:id="@+id/recentIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="11dp"
                        android:layout_centerVertical="true"
                        android:src="@android:drawable/ic_menu_recent_history"
                        android:tint="@color/dark_gray"
                        android:contentDescription="Recent" />

                    <TextView
                        android:id="@+id/recentTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recent Opened News"
                        android:textSize="22sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_toEndOf="@id/recentIcon"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="21dp" />
                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <include layout="@layout/bottom_navigation_bar" />

</RelativeLayout>

