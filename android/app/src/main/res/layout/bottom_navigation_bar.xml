<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavigationBar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bottom_nav_height"
    android:background="@color/dark_gray"
    android:layout_alignParentBottom="true">

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="@dimen/bottom_nav_icon_size"
        android:layout_height="@dimen/bottom_nav_icon_size"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_revert"
        android:tint="@color/icon_gray"
        android:contentDescription="Back" />

    <!-- Center Circle with Puzzle Icon -->
    <RelativeLayout
        android:layout_width="89dp"
        android:layout_height="89dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="-22dp"
        android:background="@drawable/circle_background">

        <ImageButton
            android:id="@+id/puzzleButton"
            android:layout_width="@dimen/bottom_nav_icon_size"
            android:layout_height="@dimen/bottom_nav_icon_size"
            android:layout_centerInParent="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_agenda"
            android:tint="@color/icon_gray"
            android:contentDescription="Puzzle" />
    </RelativeLayout>

    <!-- Menu Button -->
    <ImageButton
        android:id="@+id/menuButton"
        android:layout_width="@dimen/bottom_nav_icon_size"
        android:layout_height="@dimen/bottom_nav_icon_size"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_sort_by_size"
        android:tint="@color/icon_gray"
        android:contentDescription="Menu" />

    <!-- PuRe Text -->
    <TextView
        android:id="@+id/pureText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PuRe"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:fontFamily="sans-serif"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="8dp" />

</RelativeLayout>

