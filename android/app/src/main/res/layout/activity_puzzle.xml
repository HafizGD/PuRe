<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigationBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_small">

            <!-- News Title -->
            <TextView
                android:id="@+id/namaArt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="16dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Puzzle Container -->
            <RelativeLayout
                android:layout_width="394dp"
                android:layout_height="462dp"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/card_background"
                android:elevation="@dimen/card_elevation">

                <TextView
                    android:id="@+id/puzzleTitle"
                    android:layout_width="194dp"
                    android:layout_height="wrap_content"
                    android:text="Solve the puzzle !"
                    android:textSize="24sp"
                    android:textStyle="normal"
                    android:textColor="@color/white"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="19dp"
                    android:background="@drawable/dark_card_background"
                    android:padding="8dp" />

                <!-- Puzzle Grid 3x3 -->
                <GridLayout
                    android:id="@+id/puzzleGrid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="3"
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/puzzleTitle"
                    android:layout_marginTop="33dp"
                    android:padding="20dp" />
            </RelativeLayout>

            <!-- Button Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="16dp">

                <Button
                    android:id="@+id/buttonSkip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Skip"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_dark_background"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/resetButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@android:drawable/ic_menu_revert"
                    android:contentDescription="Reset Puzzle"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <include layout="@layout/bottom_navigation_bar" />

</RelativeLayout>

