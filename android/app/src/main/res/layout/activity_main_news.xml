<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigationBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_small">

            <!-- Header Card with Image -->
            <RelativeLayout
                android:layout_width="394dp"
                android:layout_height="175dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_background"
                android:elevation="@dimen/card_elevation">

                <ImageView
                    android:id="@+id/mainNewsImage"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_centerInParent="true"
                    android:background="@color/dark_gray"
                    android:contentDescription="Main news image" />

                <RelativeLayout
                    android:id="@+id/headerInfo"
                    android:layout_width="112dp"
                    android:layout_height="26dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="14dp"
                    android:alpha="0.8">

                    <TextView
                        android:id="@+id/headerTitle"
                        android:layout_width="94dp"
                        android:layout_height="13dp"
                        android:text="Title"
                        android:textSize="11sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.5" />

                    <TextView
                        android:id="@+id/headerSubtitle"
                        android:layout_width="112dp"
                        android:layout_height="13dp"
                        android:layout_below="@id/headerTitle"
                        android:text="Subtitle"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="0.4" />
                </RelativeLayout>
            </RelativeLayout>

            <!-- News Title -->
            <TextView
                android:id="@+id/newsTitle"
                android:layout_width="322dp"
                android:layout_height="wrap_content"
                android:text="Kantin PENS Menjadi Pusat Perhatian"
                android:textSize="22sp"
                android:textStyle="normal"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="17dp"
                android:layout_marginStart="9dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- News Content Card -->
            <RelativeLayout
                android:layout_width="394dp"
                android:layout_height="480dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/white_card_background"
                android:elevation="@dimen/card_elevation">

                <TextView
                    android:id="@+id/newsContent1"
                    android:layout_width="367dp"
                    android:layout_height="wrap_content"
                    android:text="Lorem ipsum dolor sit amet consectetur adipiscing elit. Quisque faucibus ex sapien vitae pellentesque sem placerat. In id cursus mi pretium tellus duis convallis. Tempus leo eu aenean sed diam urna tempor. Pulvinar vivamus fringilla lacus nec metus bibendum egestas. Iaculis massa nisl malesuada lacinia integer nunc posuere. Ut hendrerit semper vel class aptent taciti sociosqu. Ad litora torquent per conubia nostra inceptos himenaeos."
                    android:textSize="14sp"
                    android:textStyle="normal"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="9dp"
                    android:layout_marginTop="18dp"
                    android:lineSpacingExtra="2dp"
                    android:justificationMode="inter_word" />

                <TextView
                    android:id="@+id/newsContent2"
                    android:layout_width="367dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/newsContent1"
                    android:layout_marginStart="9dp"
                    android:layout_marginTop="22dp"
                    android:text="Lorem ipsum dolor sit amet consectetur adipiscing elit. Quisque faucibus ex sapien vitae pellentesque sem placerat. In id cursus mi pretium tellus duis convallis. Tempus leo eu aenean sed diam urna tempor. Pulvinar vivamus fringilla lacus nec metus bibendum egestas. Iaculis massa nisl malesuada lacinia integer nunc posuere."
                    android:textSize="14sp"
                    android:textStyle="normal"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="2dp"
                    android:justificationMode="inter_word" />

                <ImageView
                    android:id="@+id/bookmarkIcon"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="52dp"
                    android:src="@android:drawable/star_big_off"
                    android:tint="@color/dark_gray"
                    android:contentDescription="Bookmark" />

                <ImageView
                    android:id="@+id/globeIcon"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_alignParentEnd="true"
                    android:layout_below="@id/bookmarkIcon"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="4dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    android:tint="@color/dark_gray"
                    android:contentDescription="Globe" />
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <include layout="@layout/bottom_navigation_bar" />

</RelativeLayout>

