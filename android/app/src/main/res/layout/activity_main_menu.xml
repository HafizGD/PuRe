<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigationBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_small">

            <!-- Title Section -->
            <LinearLayout
                android:id="@+id/textContentTitle"
                android:layout_width="296dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/margin_large"
                android:layout_marginStart="@dimen/margin_large">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="296dp"
                    android:layout_height="wrap_content"
                    android:text="PuRe"
                    android:textSize="72sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.03"
                    android:lineSpacingExtra="0sp"
                    android:lineSpacingMultiplier="1.2" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="296dp"
                    android:layout_height="wrap_content"
                    android:text="Subtitle"
                    android:textSize="32sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="0sp"
                    android:lineSpacingMultiplier="1.2" />
            </LinearLayout>

            <!-- Want to know more section -->
            <TextView
                android:id="@+id/wantToKnowMore"
                android:layout_width="271dp"
                android:layout_height="wrap_content"
                android:text="Want to know more?"
                android:textSize="28sp"
                android:textStyle="normal"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="@dimen/margin_large"
                android:layout_marginStart="@dimen/margin_large" />

            <!-- Search Box -->
            <RelativeLayout
                android:layout_width="364dp"
                android:layout_height="35dp"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginStart="@dimen/margin_medium"
                android:background="@drawable/white_card_background"
                android:elevation="@dimen/card_elevation">

                <ImageView
                    android:id="@+id/searchIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="16dp"
                    android:src="@android:drawable/ic_menu_search"
                    android:tint="@color/text_primary" />
            </RelativeLayout>

            <!-- Trending News Card -->
            <RelativeLayout
                android:layout_width="394dp"
                android:layout_height="122dp"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginStart="@dimen/margin_small"
                android:background="@drawable/card_background"
                android:elevation="@dimen/card_elevation" />

            <!-- Trending News Section -->
            <RelativeLayout
                android:layout_width="394dp"
                android:layout_height="325dp"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginStart="@dimen/margin_small"
                android:background="@drawable/card_background"
                android:elevation="@dimen/card_elevation">

                <TextView
                    android:id="@+id/trendingNewsTitle"
                    android:layout_width="194dp"
                    android:layout_height="wrap_content"
                    android:text="Trending News"
                    android:textSize="24sp"
                    android:textStyle="normal"
                    android:textColor="@color/white"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="19dp"
                    android:background="@drawable/dark_card_background"
                    android:padding="8dp"
                    android:gravity="center" />

                <!-- News Item 1 -->
                <RelativeLayout
                    android:layout_width="378dp"
                    android:layout_height="93dp"
                    android:layout_marginStart="9dp"
                    android:layout_marginTop="72dp"
                    android:background="@drawable/white_card_background"
                    android:elevation="@dimen/card_elevation">

                    <ImageView
                        android:id="@+id/newsImage1"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_marginStart="12dp"
                        android:layout_centerVertical="true"
                        android:background="@color/dark_gray"
                        android:contentDescription="News image" />

                    <TextView
                        android:id="@+id/newsTitle1"
                        android:layout_width="213dp"
                        android:layout_height="wrap_content"
                        android:text="Kantin PENS Menjadi Pusat Perhatian"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_toEndOf="@id/newsImage1"
                        android:layout_marginStart="17dp"
                        android:layout_centerVertical="true"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <ImageView
                        android:id="@+id/bookmarkIcon1"
                        android:layout_width="31dp"
                        android:layout_height="31dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="27dp"
                        android:src="@android:drawable/star_big_off"
                        android:tint="@color/dark_gray"
                        android:contentDescription="Bookmark" />
                </RelativeLayout>

                <!-- News Item 2 -->
                <RelativeLayout
                    android:layout_width="378dp"
                    android:layout_height="93dp"
                    android:layout_marginStart="9dp"
                    android:layout_marginTop="182dp"
                    android:background="@drawable/white_card_background"
                    android:elevation="@dimen/card_elevation">

                    <ImageView
                        android:id="@+id/newsImage2"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_marginStart="12dp"
                        android:layout_centerVertical="true"
                        android:background="@color/dark_gray"
                        android:contentDescription="News image" />

                    <TextView
                        android:id="@+id/newsTitle2"
                        android:layout_width="213dp"
                        android:layout_height="wrap_content"
                        android:text="Lorem ipsum dolor sit amet astaganaga"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_toEndOf="@id/newsImage2"
                        android:layout_marginStart="17dp"
                        android:layout_centerVertical="true"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <ImageView
                        android:id="@+id/bookmarkIcon2"
                        android:layout_width="31dp"
                        android:layout_height="31dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="27dp"
                        android:src="@android:drawable/star_big_off"
                        android:tint="@color/dark_gray"
                        android:contentDescription="Bookmark" />
                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <include layout="@layout/bottom_navigation_bar" />

</RelativeLayout>

